{
  "version": 2,

  "routes": [
    { "src": "/feed.xml", "dest": "/api/feed.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "^/contact$", "dest": "/api/contact.js" },
    { "src": "^/auth/request$", "dest": "/api/auth/request.js" },
    { "src": "^/auth/verify$", "dest": "/api/auth/verify.js" },

    { "src": "/posts", "dest": "/api/posts.js" },

    { "handle": "filesystem" },

    { "src": "/(.*)", "dest": "/dist/portfolio/browser/index.html" },
    {
      "src": "/(.*)\\.(js|css|map|png|jpe?g|webp|gif|svg|ico|txt|json|woff2?)",
      "dest": "/dist/portfolio/browser/$1.$2"
    }
  ]
}
